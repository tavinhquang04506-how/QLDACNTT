# ============================================================
# Development Dockerfile for NEXUS HRMS Frontend (Vite HMR)
# ============================================================
FROM node:20-alpine

WORKDIR /app

ENV VITE_API_URL=http://localhost:8000/api

COPY package*.json ./
RUN npm install

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
