# Server
PORT=8000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nexus_hrms
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Authentication
JWT_SECRET=nexus_hrms_jwt_secret_key_2026_fwb
JWT_EXPIRES_IN=30m

# CORS
FRONTEND_URL=http://localhost:3000

# Test database (created/dropped by `npm test`; must end with _test)
DB_NAME_TEST=nexus_hrms_test

# Optional: comma-separated CORS origins (defaults to localhost 3000-3005 and 5173)
# CORS_ORIGINS=http://localhost:3002

# Set only when the API runs behind a reverse proxy: number of proxy hops (e.g. 1) or a subnet list.
# Needed so the login rate limiter sees real client IPs. Never "true".
# TRUST_PROXY=1

# Company time zone ("today", the 08:00 late threshold and month boundaries)
# APP_TIMEZONE=Asia/Ho_Chi_Minh

# Minimum seconds between a kiosk check-in and check-out scan of the same person
# PUNCH_MIN_GAP_SECONDS=60

# Gemini AI Copilot Configuration (Server-side only — never expose key to FrontEnd)
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_TOOL_ROUNDS=3
AI_MAX_MESSAGE_CHARS=4000
AI_REQUESTS_PER_MINUTE=10
